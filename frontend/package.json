{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve web",
    "start:web": "ng serve web --port 4200",
    "start:admin": "ng serve admin --port 4201",
    "build": "ng build",
    "build:all": "ng build ui && ng build api-client && ng build auth && ng build web && ng build admin",
    "format": "prettier --write \"projects/**/*.{ts,html,scss,css,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"projects/**/*.{ts,html,scss,css,json}\" \"*.{json,md}\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng build ui && ng build api-client && ng build auth && ng test web --watch=false && ng test admin --watch=false"
  },
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "lucide-angular": "^0.468.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.1.13",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.13",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
